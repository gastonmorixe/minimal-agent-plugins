{
  "name": "ma-llm-clinepass-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "External provider plugin for minimal-agent: ClinePass (OpenAI-compatible open-weight models via api.cline.bot).",
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run ../scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run ../scripts/check.ts"
  },
  "peerDependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#e8d7539906fad6ac1ef6429e2eb5a1fb34b4bd35"
  }
}
