    "check": "bun run ../scripts/check.ts"
  },
  "peerDependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#b1b211c0d41150ce16f3fee9cd0bb4721e1d5486"
