{
  "name": "ma-llm-opencode-go-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "External provider plugin for minimal-agent: OpenCode Go (OpenAI + Anthropic compatible gateway).",
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run ../scripts/typecheck.ts",
