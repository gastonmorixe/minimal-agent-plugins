{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["@minimal-agent/config/biome"],
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "ma-*-plugin/**",
      "scripts/**",
      "tests/**",
      "types/**",
      "!**/goldens/**",
      "package.json",
      "tsconfig.json",
      "biome.json",
      ".oxlintrc.json",
      "tsdoc.json",
      "!**/node_modules/**",
      "!**/.net-dbg/**",
      "!**/tmp/**",
      "!**/.tmp/**",
      "!**/bun.lock",
      "!**/native/build/**",
      "!**/PROMPT.md",
      "!**/prompts/**/*.md",
      "!ma-fetch-plugin/docs/persistent-sessions-and-x.md",
      "!ma-fetch-plugin/handlers/fixtures"
    ]
  }
}
