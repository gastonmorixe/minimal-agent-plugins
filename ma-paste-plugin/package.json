{
  "name": "ma-paste-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Text paste refs: a paste goes to a session file, the editor holds a short ref, and each send expands the ref to the file content.",
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run ../scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run ../scripts/check.ts"
  }
}
