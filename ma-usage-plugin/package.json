{
  "name": "ma-usage-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "External usage overlay plugin for minimal-agent.",
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run ../scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run ../scripts/check.ts"
  },
  "peerDependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#ddc795e9ddf2397ab343d7299ac191f51bd9c982"
  }
}
