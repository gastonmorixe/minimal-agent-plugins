{
  "name": "ma-usage-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "External usage overlay plugin for minimal-agent.",
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run ../scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run ../scripts/check.ts"
  },
  "peerDependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#874db827f25d59dfb4599f0e12eee8c3d1db7589"
  }
}
