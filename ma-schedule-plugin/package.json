{
  "name": "ma-schedule-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Run prompts on a schedule: the ScheduleCron* tools, /loop and /schedule commands, and a heartbeat that injects due tasks between turns.",
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "typecheck": "bun run ../scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run ../scripts/check.ts"
  }
}
