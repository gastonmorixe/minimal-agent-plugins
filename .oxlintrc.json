{
  "extends": ["./node_modules/@minimal-agent/config/oxlintrc.json"],
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "oxc", "import"],
  "jsPlugins": [
    {
      "name": "ma",
      "specifier": "./node_modules/@minimal-agent/core/scripts/lint/no-direct-stdio.mjs"
    },
    {
      "name": "jsdoc-js",
      "specifier": "eslint-plugin-jsdoc"
    },
    {
      "name": "tsdoc",
      "specifier": "eslint-plugin-tsdoc"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "settings": {
    "jsdoc": {
      "ignorePrivate": true,
      "ignoreInternal": true
    }
  },
  "rules": {
    // No module writes to the process stdout or stderr on its own. Product output goes
    // through an injected writer, diagnostics through the diagnostic bus or the plugin logger.
    "ma/no-direct-stdio": "error",
    "typescript/require-array-sort-compare": "off",
    "typescript/consistent-return": "off",
    "jsdoc-js/require-jsdoc": [
      "error",
      {
        "publicOnly": true,
        "require": {
          "ArrowFunctionExpression": false,
          "ClassDeclaration": true,
          "ClassExpression": true,
          "FunctionDeclaration": true,
          "FunctionExpression": false,
          "MethodDefinition": true
        }
      }
    ],
    "jsdoc-js/require-description": "error",
    "jsdoc-js/require-param": "off",
    "jsdoc-js/require-param-description": "off",
    "jsdoc-js/require-returns": "off",
    "jsdoc-js/require-returns-description": "off",
    "jsdoc-js/check-param-names": "error",
    "max-lines": [
      "error",
      {
        "max": 800,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "tsdoc/syntax": "error"
  },
  "overrides": [
    {
      // ma/no-direct-stdio allowlist. Keep it equal to tests/no-direct-stdio.baseline.json
      // (a test checks that): `exempt` globs first (tests, dev tooling), then one
      // entry per file that may still write directly. The count per file can only go down.
      "files": [
        "**/*.test.ts",
        "**/*fixture*.ts",
        "**/__fixtures__/**",
        "**/*.e2e.ts",
        "**/e2e/**",
        "scripts/**",
        "**/scripts/**",
        "tests/**",
        "ma-background-plugin/bin/runner.ts",
        "ma-chrome-cdp-plugin/bin/cdp-server.ts",
        "ma-chrome-cdp-plugin/bin/cdpd.ts",
        "ma-computer-use-plugin/bin/cud.ts",
        "ma-fetch-plugin/backends/obscura.ts",
        "ma-file-lock-plugin/cli.ts",
        "ma-header-template-plugin/handlers/on_session_will_start.ts",
        "ma-history-plugin/cli.ts",
        "ma-llm-cursor-plugin/bidi-debug.ts",
        "ma-memory-plugin/cli.ts",
        "ma-slash-menu-plugin/bin/preview.ts",
        "ma-speak-plugin/backends/macos-say.ts",
        "ma-tasks-plugin/cli.ts",
        "ma-web-search-plugin/cli.ts"
      ],
      "rules": { "ma/no-direct-stdio": "off" }
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "jsdoc-js/require-jsdoc": "off",
        "jsdoc-js/require-description": "off",
        "jsdoc-js/check-param-names": "off",
        "require-yield": "off"
      }
    },
    {
      "files": ["**/static-catalog-part-*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.net-dbg/**",
    "**/docs/**",
    "**/goldens/**",
    "**/dist/**",
    "**/build/**",
    "**/tmp/**",
    "**/.tmp/**"
  ]
}
