{
  "name": "ma-agents-md-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "External user plugin for minimal-agent: injects AGENTS.md (global + project) into the system prompt.",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run ../scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run ../scripts/check.ts"
  }
}
