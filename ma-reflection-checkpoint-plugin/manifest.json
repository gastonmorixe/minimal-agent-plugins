{
  "id": "reflection-checkpoint",
  "name": "Reflection Checkpoint",
  "version": "0.1.0",
  "description": "The plugin adds a soft reflection checkpoint after each N tool steps (default 50). Before the next model request, the plugin waits (default 60 s, Esc stops this time) and adds a `<ma::agent::reflection-checkpoint />` text. The model can write `<ma::emit::reflection-ack silence-for=\"K\" reason=\"...\" />` to prevent the next K checkpoints. By default, the plugin is off (`manifest.enabled` is `false`). To enable it, set `plugins[\"reflection-checkpoint\"].enabled` to `true` in `~/.minimal-agent/config.jsonc`.",
  "enabled": false,
  "permissions": ["hooks:tool.didBatch", "hooks:turn.didEnd", "hooks:turn.aborted"],
  "headless": {
    "promptFragments": [
      {
        "id": "loop_safety",
        "handler": {
          "type": "module",
          "path": "./handlers/fragment.ts",
          "export": "default"
        },
        "timeoutMs": 1000,
        "order": 100,
        "placement": "afterInstructions"
      }
    ],
    "hooks": [
      {
        "id": "checkpoint",
        "channel": "tool.didBatch",
        "handler": {
          "type": "module",
          "path": "./handlers/did-batch.ts",
          "export": "default"
        },
        "priority": 0
      },
      {
        "id": "run_end",
        "channel": "turn.didEnd",
        "handler": {
          "type": "module",
          "path": "./handlers/run-end.ts",
          "export": "default"
        }
      },
      {
        "id": "run_aborted",
        "channel": "turn.aborted",
        "handler": {
          "type": "module",
          "path": "./handlers/run-end.ts",
          "export": "default"
        }
      }
    ],
    "tools": [
      {
        "id": "reflection_ack",
        "trigger": {
          "type": "inline_tag",
          "tag": "reflection-ack"
        },
        "handler": {
          "type": "module",
          "path": "./handlers/ack.ts",
          "export": "default"
        },
        "interactive": false
      }
    ]
  }
}
