{
  "id": "ma-base-prompt-plugin",
  "name": "Base prompt",
  "version": "0.1.0",
  "required": true,
  "description": "Provides the base identity and the 2 base system slots (instructions, tool output conventions) as data files.",
  "systemPromptBase": {
    "id": "base",
    "entry": "./provider.ts",
    "identity": true,
    "slots": ["instructions", "toolOutputConventions"]
  },
  "capabilities": [],
  "sideband": [
    {
      "kind": "behavior",
      "direction": "to-model",
      "placement": "system",
      "attrs": {
        "name": {
          "type": "string"
        }
      },
      "body": "raw",
      "layout": "block",
      "trust": "harness",
      "summary": "System prompt section of role behavior."
    },
    {
      "kind": "context",
      "direction": "to-model",
      "placement": "system",
      "attrs": {
        "name": {
          "type": "string"
        }
      },
      "body": "raw",
      "layout": "block",
      "trust": "harness",
      "summary": "System prompt section of role context."
    },
    {
      "kind": "emit",
      "direction": "to-model",
      "placement": "system",
      "attrs": {
        "name": {
          "type": "string"
        }
      },
      "body": "raw",
      "layout": "block",
      "trust": "harness",
      "summary": "System prompt section of role emit."
    },
    {
      "kind": "mode",
      "direction": "to-model",
      "placement": "system",
      "attrs": {
        "name": {
          "type": "string"
        }
      },
      "body": "raw",
      "layout": "block",
      "trust": "harness",
      "summary": "System prompt section of role mode."
    },
    {
      "kind": "tool",
      "direction": "to-model",
      "placement": "system",
      "attrs": {
        "name": {
          "type": "string"
        }
      },
      "body": "raw",
      "layout": "block",
      "trust": "harness",
      "summary": "System prompt section of role tool."
    }
  ]
}
