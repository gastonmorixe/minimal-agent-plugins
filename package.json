{
  "name": "minimal-agent-plugins",
  "version": "0.1.0",
  "private": true,
  "description": "External user plugins for minimal-agent. Each subdirectory is one plugin package.",
  "homepage": "https://github.com/gastonmorixe/minimal-agent-plugins",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent-plugins.git"
  },
  "workspaces": {
    "packages": [
      "ma-*-plugin",
      "ma-*-kit"
    ],
    "catalog": {
      "@biomejs/biome": "2.6.6",
      "bun-types": "^1.4.4",
      "eslint-plugin-jsdoc": "^65.4.5",
      "eslint-plugin-tsdoc": "^0.5.4",
      "oxlint": "1.92.0",
      "oxlint-tsgolint": "7.0.2006",
      "typescript": "7.0.2"
    }
  },
  "type": "module",
  "dependencies": {
    "@minimal-agent/core": "git+ssh://git@github.com/gastonmorixe/minimal-agent-core.git#9c9aa341054a6d10e981e29a03c51187fe7ec623"
  },
  "scripts": {
    "test": "bun test",
    "test:golden": "bun test tests/request-golden",
    "test:golden:update": "UPDATE_REQUEST_GOLDENS=1 bun test tests/request-golden",
    "test:plugins": "bun run --parallel --elide-lines=20 --filter 'ma-*' test",
    "test:ste": "bun test tests/ste",
    "ste:gate": "bun run scripts/ste-check.ts",
    "ste:strict": "bun run scripts/ste-check.ts --strict",
    "ste:report": "bun run scripts/ste-check.ts --report",
    "ste:write": "bun run scripts/ste-check.ts --write",
    "ste:parity": "bun run scripts/ste-parity.ts",
    "ste:dict": "bun run scripts/ste-dict.ts",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "bun run scripts/check.ts",
    "pin:core": "bun run scripts/pin-core.ts",
    "workspaces:list": "bun pm ls --all",
    "prepare": "husky",
    "commitlint": "commitlint",
    "commitlint:last": "commitlint --last --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@minimal-agent/config": "git+ssh://git@github.com/gastonmorixe/minimal-agent-config.git#f5d11c0f9b5f95f5bdc9d50b6cfd8bc32f9a74eb",
    "bun-types": "catalog:",
    "eslint-plugin-jsdoc": "catalog:",
    "eslint-plugin-tsdoc": "catalog:",
    "husky": "^9.1.7",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
