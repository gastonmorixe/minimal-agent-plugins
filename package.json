{
  "name": "minimal-agent-plugins",
  "private": true,
  "version": "0.0.0",
  "description": "External user plugins for minimal-agent. Each subdirectory is one plugin package.",
  "type": "module",
  "workspaces": [
    "ma-*-plugin"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "bun run scripts/check.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "bun-types": "^1.3.14",
    "eslint-plugin-jsdoc": "^63.0.12",
    "eslint-plugin-tsdoc": "^0.5.2",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/gastonmorixe/minimal-agent-plugins",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gastonmorixe/minimal-agent-plugins.git"
  }
}
