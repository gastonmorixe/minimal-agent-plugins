{
  "name": "minimal-agent-plugins",
  "private": true,
  "version": "0.0.0",
  "description": "External user plugins for minimal-agent. Each subdirectory is one plugin package.",
  "type": "module",
  "workspaces": [
    "ma-*-plugin"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run scripts/typecheck.ts",
    "typecheck:fast": "bun x tsgo --noEmit",
    "typecheck:fallback": "bun x tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "bun run scripts/check.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@typescript/native-preview": "beta",
    "bun-types": "^1.3.14",
    "eslint-plugin-jsdoc": "^63.0.2",
    "eslint-plugin-tsdoc": "^0.5.2",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.22.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  }
}
