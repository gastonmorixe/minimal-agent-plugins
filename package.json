{
  "name": "minimal-agent-plugins",
  "private": true,
  "version": "0.0.0",
  "description": "External user plugins for minimal-agent. Each subdirectory is one plugin package.",
  "type": "module",
  "workspaces": [
    "ma-agent-writing-style-plugin",
    "ma-background-plugin",
    "ma-chrome-cdp-plugin",
    "ma-computer-use-plugin",
    "ma-fetch-plugin",
    "ma-skills-plugin",
    "ma-slash-menu-plugin",
    "ma-speak-plugin"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run scripts/typecheck.ts",
    "typecheck:fast": "bun x tsgo --noEmit",
    "typecheck:fallback": "bun x tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "imports": "biome check --write --formatter-enabled=false --linter-enabled=false .",
    "check": "bun run scripts/check.ts"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@typescript/native-preview": "beta",
    "bun-types": "1.3.11",
    "eslint-plugin-jsdoc": "^62.9.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.6"
  }
}
