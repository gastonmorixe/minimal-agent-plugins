{
  "id": "turn-recovery",
  "name": "Turn recovery",
  "version": "0.1.0",
  "description": "Owns the model-facing text that core makes to recover a turn. The text covers continue nudges, the assistant placeholder and runtime turn markers. It also covers the tool results of a failed, stopped, aborted or denied call, the user media markers and the context compaction text.",
  "required": true,
  "capabilities": [],
  "syntheticText": [
    {
      "id": "tool-result",
      "entry": "./provider.ts",
      "export": "createTurnRecoveryProvider",
      "kinds": [
        "continue.max_tokens",
        "continue.stream_interrupted",
        "assistant.placeholder",
        "runtime.turn_aborted",
        "runtime.session_resumed",
        "runtime.stream_interrupted",
        "tool_result.aborted",
        "tool_result.interrupted_by_stop",
        "tool_result.unknown_tool",
        "tool_result.handler_error",
        "tool_result.no_executor",
        "tool_result.subprocess_overflow",
        "tool_result.lock_timeout",
        "tool_result.lock_failed",
        "tool_result.policy_denied",
        "tool_result.canceled",
        "tool_result.policy_hook_failed",
        "tool_result.policy_rewrite_note",
        "tool_result.non_tool_result",
        "tool_result.invalid_input",
        "runtime.hook_denied",
        "user_media.rejected",
        "user_media.unavailable",
        "compact.summary_system",
        "compact.tail_checkpoint",
        "compact.local_checkpoint"
      ]
    }
  ],
  "sideband": [
    {
      "kind": "turn-aborted",
      "direction": "to-model",
      "placement": "turn",
      "attrs": {},
      "body": "none",
      "trust": "harness",
      "summary": "The user stopped the previous turn."
    },
    {
      "kind": "session-resumed",
      "direction": "to-model",
      "placement": "turn",
      "attrs": {},
      "body": "none",
      "trust": "harness",
      "summary": "The session started again with work that is not complete."
    },
    {
      "kind": "stream-interrupted",
      "direction": "to-model",
      "placement": "turn",
      "attrs": {},
      "body": "none",
      "trust": "harness",
      "summary": "The provider closed the previous response before it was complete."
    },
    {
      "kind": "reflection-checkpoint",
      "direction": "to-model",
      "placement": "turn",
      "attrs": {
        "round": {
          "type": "int"
        },
        "cooldown-applied-seconds": {
          "type": "int"
        }
      },
      "body": "none",
      "trust": "harness",
      "summary": "Soft checkpoint after a number of tool rounds."
    },
    {
      "kind": "reflection-ack",
      "direction": "from-model",
      "placement": "inline",
      "attrs": {
        "silence-for": {
          "type": "int"
        },
        "reason": {
          "type": "string"
        }
      },
      "body": "none",
      "trust": "untrusted",
      "summary": "The model acknowledges a checkpoint and asks for silence for K checkpoints."
    },
    {
      "kind": "max-tokens-continue",
      "direction": "to-model",
      "placement": "turn",
      "attrs": {},
      "body": "none",
      "trust": "harness",
      "summary": "The previous response stopped at the output token limit. Continue.",
      "legacy": ["ma::agent::output-truncated"]
    },
    {
      "kind": "wrap-up",
      "direction": "to-model",
      "placement": "turn",
      "attrs": {},
      "body": "text",
      "trust": "harness",
      "summary": "Host note for the final short turn of a run."
    },
    {
      "kind": "compaction",
      "direction": "to-model",
      "placement": "turn",
      "attrs": {
        "kind": {
          "type": "enum",
          "values": ["tail", "local", "remote", "remote-empty"]
        },
        "enc": {
          "type": "string"
        }
      },
      "body": "none",
      "trust": "harness",
      "summary": "Marker of a context compaction."
    }
  ]
}
