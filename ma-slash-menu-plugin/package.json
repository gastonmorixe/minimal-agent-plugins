{
  "name": "ma-slash-menu-plugin",
  "private": true,
  "version": "0.1.0",
  "description": "Slash-command palette for minimal-agent. '/' for actions+skills, '$' for forced skill activation.",
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "preview": "bun run bin/preview.ts",
    "typecheck": "bun run ../scripts/typecheck.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "check": "bun run ../scripts/check.ts"
  }
}
