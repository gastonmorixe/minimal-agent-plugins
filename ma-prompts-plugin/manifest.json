{
  "id": "ma-prompts",
  "name": "Prompts",
  "version": "0.1.0",
  "description": "A library of saved prompts. The plugin keeps the prompts in the agent home directory. The user selects a prompt in the '&' menu. When the user sends a message, the plugin expands '&name' to the prompt body.",
  "permissions": [
    "hooks:editor.key",
    "hooks:editor.buffer.changed",
    "hooks:editor.footer.set",
    "hooks:editor.buffer.styles",
    "hooks:editor.buffer.set",
    "hooks:turn.willStart"
  ],
  "headless": {
    "tools": [
      {
        "id": "prompt_new",
        "trigger": {
          "type": "tool",
          "tool": {
            "name": "PromptNew",
            "description": "Save a prompt in the prompt library of the user. Use it when the user tells you to save an instruction to use again. Do not use it for Agent Skills, or without an instruction from the user. The tool gives a result line. Then the '&' menu shows the prompt, and '&name' expands to it.",
            "input_schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Letters, digits, the hyphen and `_` only. The user types it after '&'."
                },
                "body": {
                  "type": "string",
                  "description": "The full prompt text, kept as you wrote it. Include all that the user wants to use again."
                },
                "description": {
                  "type": "string",
                  "description": "One line that the '&' menu shows."
                },
                "overwrite": {
                  "type": "boolean",
                  "description": "Replace a prompt with the same name. With `false` (the default), the tool gives an error."
                }
              },
              "required": ["name", "body"],
              "additionalProperties": false
            },
            "explicitName": true,
            "reason": "PromptsPromptNew is a stutter"
          }
        },
        "handler": {
          "type": "module",
          "path": "./handlers/prompt_new.ts",
          "export": "default"
        },
        "interactive": false
      },
      {
        "id": "prompt_list",
        "trigger": {
          "type": "tool",
          "tool": {
            "name": "PromptList",
            "description": "Show all saved prompts in the prompt library of the user. Use it before you save, change or delete a prompt. Use it also when the user names a saved prompt, or when a typed '&name' did not expand. To read a body, use `PromptShow`. The tool gives the name, description, `scope` and file path of each prompt.",
            "input_schema": {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            },
            "explicitName": true,
            "reason": "PromptsPromptList is a stutter"
          }
        },
        "handler": {
          "type": "module",
          "path": "./handlers/prompt_list.ts",
          "export": "default"
        },
        "interactive": false
      },
      {
        "id": "prompt_show",
        "trigger": {
          "type": "tool",
          "tool": {
            "name": "PromptShow",
            "description": "Show the full body of one saved prompt. Use it to read or show the accurate prompt text. When you do not know the name, or to find prompts, use `PromptList`.\n\nThe tool gives the full body text, or an error for an unknown name.",
            "input_schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The prompt name."
                }
              },
              "required": ["name"],
              "additionalProperties": false
            },
            "explicitName": true,
            "reason": "PromptsPromptShow is a stutter"
          }
        },
        "handler": {
          "type": "module",
          "path": "./handlers/prompt_show.ts",
          "export": "default"
        },
        "interactive": false
      },
      {
        "id": "prompt_edit",
        "trigger": {
          "type": "tool",
          "tool": {
            "name": "PromptEdit",
            "description": "Change the description, the body or the name of one saved prompt. Use it when the user tells you to change a saved prompt. Give one or more fields. Only those fields change. To make a prompt, use `PromptNew`.\n\nThe tool gives a result line with the prompt name, or an error.",
            "input_schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The prompt name."
                },
                "description": {
                  "type": "string",
                  "description": "The new description (one line)."
                },
                "body": {
                  "type": "string",
                  "description": "The new full prompt text."
                },
                "rename": {
                  "type": "string",
                  "description": "The new name of the prompt."
                }
              },
              "required": ["name"],
              "additionalProperties": false
            },
            "explicitName": true,
            "reason": "PromptsPromptEdit is a stutter"
          }
        },
        "handler": {
          "type": "module",
          "path": "./handlers/prompt_edit.ts",
          "export": "default"
        },
        "interactive": false
      },
      {
        "id": "prompt_delete",
        "trigger": {
          "type": "tool",
          "tool": {
            "name": "PromptDelete",
            "description": "Delete one saved prompt. Use it only when the user tells you to remove a prompt. To change a prompt, use `PromptEdit`. To replace a prompt, use `PromptNew` with `overwrite`, not this tool.\n\nThe tool gives a result line, or an error for an unknown name.",
            "input_schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The prompt name."
                }
              },
              "required": ["name"],
              "additionalProperties": false
            },
            "explicitName": true,
            "reason": "PromptsPromptDelete is a stutter"
          }
        },
        "handler": {
          "type": "module",
          "path": "./handlers/prompt_delete.ts",
          "export": "default"
        },
        "interactive": false
      }
    ],
    "hooks": [
      {
        "id": "on_key",
        "channel": "editor.key",
        "handler": {
          "type": "module",
          "path": "./handlers/on_key.ts",
          "export": "default"
        },
        "priority": 60
      },
      {
        "id": "on_turn_will_start",
        "channel": "turn.willStart",
        "handler": {
          "type": "module",
          "path": "./handlers/on_turn_will_start.ts",
          "export": "default"
        },
        "priority": 55
      }
    ],
    "events": [
      {
        "id": "on_buffer_changed",
        "on": "editor.buffer.changed",
        "handler": {
          "type": "module",
          "path": "./handlers/on_buffer_changed.ts",
          "export": "default"
        }
      }
    ]
  },
  "ui": {
    "setup": {
      "type": "module",
      "path": "./ui/setup.ts",
      "export": "default"
    }
  }
}
