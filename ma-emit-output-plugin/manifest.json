{
  "id": "emit-output",
  "name": "Emit Output",
  "version": "0.1.0",
  "description": "This plugin shows the content of a file or a blob in the response stream. The model does not copy the bytes. The plugin is for the ascii-renderer skill and for other tool output. If the model copies such output, the output can become cut or incorrect.",
  "capabilities": ["blobs:read"],
  "headless": {
    "tools": [
      {
        "id": "emit_output",
        "trigger": {
          "type": "inline_tag",
          "tag": "output"
        },
        "handler": {
          "type": "module",
          "path": "./handlers/emit_output.ts",
          "export": "default"
        },
        "interactive": false
      }
    ]
  },
  "ui": {
    "setup": {
      "type": "module",
      "path": "./ui/setup.ts",
      "export": "default"
    }
  },
  "sideband": [
    {
      "kind": "output",
      "direction": "from-model",
      "placement": "inline",
      "attrs": {
        "path": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "body": "text",
      "trust": "untrusted",
      "summary": "The model shows a full tool output or file to the user."
    }
  ]
}
