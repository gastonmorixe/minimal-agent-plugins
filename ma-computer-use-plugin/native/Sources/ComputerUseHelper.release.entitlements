<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox OFF: required to read/control OTHER applications via AX + CGEvent. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- NOTE: get-task-allow is intentionally ABSENT here.
         A notarized build must NOT carry get-task-allow (Apple rejects it).
         This is the entitlements file used for the Developer ID / notarized build. -->
</dict>
</plist>
